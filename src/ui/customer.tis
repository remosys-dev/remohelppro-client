// Customer window for 32-bit Windows (2026-10-29). Logic lives in src/rl_customer.rs; this only shows state.
// !! ASCII ONLY in this file and customer.html. sciter reads the page as Shift_JIS, and Japanese text here
//    broke the script (blank window). All Japanese text comes from rl_customer::texts_json().
// !! White label: never show our product or company name.

function self.ready() {
    centerize(scaleIt(420), scaleIt(460));
}

var T = {};
try { T = JSON.parse(handler.rl_customer_texts()); } catch(e) {}

var st = { phase: "input", message: "" };

function readState() {
    try { st = JSON.parse(handler.rl_customer_state()); } catch(e) {}
}

function pad2(n) { return n < 10 ? "0" + n : "" + n; }

function elapsed() {
    if (!st.connected_at) return "00:00:00";
    var d = (new Date()).valueOf() / 1000 - st.connected_at;
    if (d < 0) d = 0;
    d = d.toInteger();
    return pad2(d / 3600) + ":" + pad2((d % 3600) / 60) + ":" + pad2(d % 60);
}

class Customer: Reactor.Component {
    function render() {
        var who = st.support_name ?
            <div .who>
                <div>{T.dest + ": "}<b>{st.support_name}</b></div>
                <div>{T.tel + ": " + st.support_tel}</div>
                {st.operator ? <div>{T.operator + ": " + st.operator}</div> : ""}
            </div> : "";

        if (st.phase == "connected") {
            return <div .page>
                <div .title>{T.title_connected}</div>
                <div .card>
                    <div .big>{T.connected}</div>
                    <div .note>{T.elapsed + " " + elapsed()}</div>
                    {who}
                    <button .end #end>{T.end}</button>
                </div>
                <div .safe>{T.safe_connected}</div>
            </div>;
        }
        if (st.phase == "ended") {
            return <div .page>
                <div .title>{T.title_ended}</div>
                <div .card>
                    <div .note>{st.message}</div>
                    <div .big style="font-size:13dip">{T.ended_note}</div>
                </div>
            </div>;
        }
        if (st.phase == "working") {
            return <div .page>
                <div .title>{T.title}</div>
                <div .card>
                    <div .big>{T.connecting}</div>
                    <div .note>{st.message}</div>
                    {who}
                </div>
            </div>;
        }
        // input / error
        return <div .page>
            <div .title>{T.title}</div>
            <div .sub>{T.prompt}</div>
            <div .card>
                <input|text .code #code maxlength="7" />
                <button .go #go>{T.go}</button>
                {st.phase == "error" ? <div .err>{st.message}</div> : ""}
            </div>
            <div .safe>{T.safe_input}</div>
        </div>;
    }

    event click $(#go) {
        var el = $(#code);
        handler.rl_customer_start(el ? el.value : "");
        readState();
        this.update();
    }

    event keydown $(#code) (evt) {
        if (isEnterKey(evt)) {
            handler.rl_customer_start($(#code).value);
            readState();
            this.update();
            return true;
        }
    }

    event click $(#end) {
        handler.rl_customer_end();
        readState();
        this.update();
    }
}

// Re-rendering while typing would wipe the code. Redraw only on state change, or every tick while connected (clock).
var lastPhase = "";
var lastMsg = "";
function tick() {
    readState();
    if (st.phase != lastPhase || st.message != lastMsg || st.phase == "connected") {
        lastPhase = st.phase;
        lastMsg = st.message;
        $(body).content(<Customer />);
    }
    // !! sciter repeats the timer only while the callback returns true. Re-arming inside it
    //    with the same function does not work (the screen froze on "connecting", 2026-10-29).
    return true;
}

// On close, report the end first if connected (never leave the session open).
function self.closing() {
    handler.rl_customer_close();
    return true;
}

readState();
lastPhase = st.phase;
lastMsg = st.message;
$(body).content(<Customer />);
self.timer(500ms, tick);
