+    /// RegisterPk checks shared by UDP and TCP/WS (moved unchanged from handle_udp).
+    /// None = ignore the message (no reply), Some(result) = reply with result.
+    async fn register_pk_common(
+        &mut self,
+        rk: RegisterPk,
+        addr: SocketAddr,
+    ) -> Option<register_pk_response::Result> {
+        if rk.uuid.is_empty() || rk.pk.is_empty() {
+            return None;
+        }
+        let id = rk.id;
+        let ip = addr.ip().to_string();
+        if id.len() < 6 {
+            return Some(UUID_MISMATCH);
+        } else if !self.check_ip_blocker(&ip, &id).await {
+            return Some(TOO_FREQUENT);
+        }
+        let peer = self.pm.get_or(&id).await;
+        let (changed, ip_changed) = {
+            let peer = peer.read().await;
+            if peer.uuid.is_empty() {
+                (true, false)
+            } else {
+                if peer.uuid == rk.uuid {
+                    if peer.info.ip != ip && peer.pk != rk.pk {
+                        log::warn!(
+                            "Peer {} ip/pk mismatch: {}/{:?} vs {}/{:?}",
+                            id,
+                            ip,
+                            rk.pk,
+                            peer.info.ip,
+                            peer.pk,
+                        );
+                        drop(peer);
+                        return Some(UUID_MISMATCH);
+                    }
+                } else {
+                    log::warn!(
+                        "Peer {} uuid mismatch: {:?} vs {:?}",
+                        id,
+                        rk.uuid,
+                        peer.uuid
+                    );
+                    drop(peer);
+                    return Some(UUID_MISMATCH);
+                }
+                let ip_changed = peer.info.ip != ip;
+                (
+                    peer.uuid != rk.uuid || peer.pk != rk.pk || ip_changed,
+                    ip_changed,
+                )
+            }
+        };
+        let mut req_pk = peer.read().await.reg_pk;
+        if req_pk.1.elapsed().as_secs() > 6 {
+            req_pk.0 = 0;
+        } else if req_pk.0 > 2 {
+            return Some(TOO_FREQUENT);
+        }
+        req_pk.0 += 1;
+        req_pk.1 = Instant::now();
+        peer.write().await.reg_pk = req_pk;
+        if ip_changed {
+            let mut lock = IP_CHANGES.lock().await;
+            if let Some((tm, ips)) = lock.get_mut(&id) {
+                if tm.elapsed().as_secs() > IP_CHANGE_DUR {
+                    *tm = Instant::now();
+                    ips.clear();
+                    ips.insert(ip.clone(), 1);
+                } else if let Some(v) = ips.get_mut(&ip) {
+                    *v += 1;
+                } else {
+                    ips.insert(ip.clone(), 1);
+                }
+            } else {
+                lock.insert(
+                    id.clone(),
+                    (Instant::now(), HashMap::from([(ip.clone(), 1)])),
+                );
+            }
+        }
+        if changed {
+            self.pm.update_pk(id, peer, addr, rk.uuid, rk.pk, ip).await;
+        }
+        Some(register_pk_response::Result::OK)
+    }
+
+    /// REMOHELP PRO: send a message to a peer that registered over TCP/WS.
+    /// Only used while that peer's current address is still the TCP one
+    /// (if it went back to UDP, RegisterPeer has changed socket_addr).
+    async fn send_to_tcp_peer(&self, id: &str, peer_addr: SocketAddr, msg: &RendezvousMessage) -> bool {
+        let Ok(bytes) = msg.write_to_bytes() else {
+            return false;
+        };
+        let mut lock = self.tcp_peers.lock().await;
+        let Some(p) = lock.get_mut(id) else {
+            return false;
+        };
+        if p.addr != peer_addr {
+            return false;
+        }
+        let ok = match &mut p.sink {
+            Sink::TcpStream(s) => matches!(timeout(5_000, s.send(Bytes::from(bytes))).await, Ok(Ok(_))),
+            Sink::Ws(ws) => matches!(
+                timeout(5_000, ws.send(tungstenite::Message::Binary(bytes))).await,
+                Ok(Ok(_))
+            ),
+        };
+        if !ok {
+            log::warn!("tcp peer {} send failed, dropped", id);
+            lock.remove(id);
+        }
+        ok
+    }
+
+    /// REMOHELP PRO: heartbeat (empty frame) to a TCP/WS-registered peer.
+    /// The client answers with an empty frame, which refreshes last_reg_time.
+    async fn send_tcp_heartbeat(&self, reg: &Option<(String, u64)>) -> bool {
+        let Some((id, conn)) = reg else {
+            return true;
+        };
+        let mut lock = self.tcp_peers.lock().await;
+        let Some(p) = lock.get_mut(id) else {
+            return false;
+        };
+        if p.conn != *conn {
+            return false;
+        }
+        let ok = match &mut p.sink {
+            Sink::TcpStream(s) => matches!(timeout(5_000, s.send(Bytes::new())).await, Ok(Ok(_))),
+            Sink::Ws(ws) => matches!(
+                timeout(5_000, ws.send(tungstenite::Message::Binary(Vec::new()))).await,
+                Ok(Ok(_))
+            ),
+        };
+        if !ok {
+            lock.remove(id);
+        }
+        ok
+    }
